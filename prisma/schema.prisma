datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(100)
  email    String   @unique @db.VarChar(100)
  senha    String   @db.VarChar(255)
  isAdmin  Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@map("usuarios")
}

model Tema {
  id        Int         @id @default(autoincrement())
  nome      String      @unique @db.VarChar(100)
  descricao String?     @db.Text
  slug      String      @unique @db.VarChar(100)
  codigoApi String?
  simulados Simulado[]
  videos    VideoAula[]
  dicas     Dica[]

  @@map("temas")
}

model Noticia {
  id             Int      @id @default(autoincrement())
  titulo         String   @db.VarChar(200)
  resumo         String   @db.VarChar(255)
  conteudo       String   @db.Text
  urlImagem      String?  @db.VarChar(500)
  dataPublicacao DateTime @default(now())

  @@map("noticias")
}

model Carreira {
  id                 Int      @id @default(autoincrement())
  nome               String   @db.VarChar(150)
  descricao          String?  @db.Text
  cursosRelacionados String[]
  habilidades        String[]
  img                String?  @db.VarChar(500)
  salarioMedio       String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  @@map("carreiras")
}

model Dica {
  id       Int     @id @default(autoincrement())
  titulo   String  @db.VarChar(150)
  conteudo String  @db.Text
  foto     String? @db.VarChar(500)
  temaId   Int?
  tema     Tema?   @relation(fields: [temaId], references: [id], onDelete: SetNull)

  @@map("dicas")
}

model Estagio {
  id                 Int      @id @default(autoincrement())
  titulo             String   @db.VarChar(200)
  descricao          String   @db.Text
  cursosRelacionados String[]
  empresa            String?  @db.VarChar(150)
  requisitos         String?  @db.Text
  urlInscricao       String?  @db.VarChar(500)
  dataPublicacao     DateTime @default(now())

  @@map("estagios")
}

model Simulado {
  id              Int     @id @default(autoincrement())
  conteudo        String  @db.Text
  pergunta        String  @db.Text
  opcaoA          String  @db.Text
  opcaoB          String  @db.Text
  opcaoC          String  @db.Text
  opcaoD          String  @db.Text
  opcaoE          String  @db.Text
  respostaCorreta String  @db.VarChar(1)
  explicacao      String  @db.Text
  materia         String  @db.VarChar(100)
  urlImagem       String? @db.VarChar(500)

  temaId Int?
  tema   Tema? @relation(fields: [temaId], references: [id], onDelete: SetNull)

  @@map("simulados")
}

model VideoAula {
  id        Int    @id @default(autoincrement())
  titulo    String @db.VarChar(200)
  descricao String @db.Text
  urlMidia  String @db.VarChar(500)
  temaId    Int?
  tema      Tema?  @relation(fields: [temaId], references: [id], onDelete: SetNull)

  @@map("video_aulas")
}

model Participantes {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(150)
  curso     String   @db.VarChar(100)
  foto      String   @db.VarChar(500)
  idade     Int
  email     String   @unique @db.VarChar(150)
  createdAt DateTime @default(now())

  @@map("participantes")
}

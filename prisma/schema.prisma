    datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    }

    generator client {
    provider = "prisma-client-js"
    }

    model Participantes {
        id        Int      @id @default(autoincrement())
        nome      String
        curso     String
        foto      String
        idade     String
        email     String   @unique
        createdAt DateTime @default(now())
    }

    model VideoAula {
        id        Int    @id @default(autoincrement())
        conteudo  String
        urlMidia  String
        descricao String
    }

    model Dicas {
        id       Int    @id @default(autoincrement())
        conteudo String
        dicas    String
    }

    model Simulado {
        id              Int    @id @default(autoincrement())
        conteudo        String
        pergunta        String
        opcaoA          String
        opcaoB          String
        opcaoC          String
        opcaoD          String
        opcaoE          String
        respostaCorreta String
        explicacao      String
        materia         String
    }

    model Usuario {
        id        Int      @id @default(autoincrement())
        nome      String   @db.VarChar(100)
        email     String   @unique @db.VarChar(100)
        senha     String   @db.VarChar(255)
        criado_em DateTime @default(now())
    }

    model Noticia {
        id              Int      @id @default(autoincrement())
        titulo          String   @db.VarChar(200)
        resumo          String   @db.VarChar(255)
        conteudo        String   @db.Text
        url_imagem      String   @db.VarChar(255)
        data_publicacao DateTime @default(now())
    }
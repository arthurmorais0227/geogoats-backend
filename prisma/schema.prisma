datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  senha      String   @db.VarChar(255)
  isAdmin    Boolean  @default(false)
  criadoEm   DateTime @default(now())
  
  resultados SimuladoResultado[]

  @@map("usuarios")
}

// Tabela estrutural para dividir a Geografia (Ex: Cartografia, Climatologia)
model Tema {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  descricao   String?  @db.Text
  
  // É uma versão do nome adaptada para funcionar em links e buscas.
  // Exemplo: Se o nome for "Geografia Física", o slug será salvo como "geografia-fisica".
  slug        String   @unique 
  
  // CAMPO PARA A API DO PLANETA INTERATIVO:
  // Como o planeta vem de fora, ele pode não entender o nome "Cartografia".
  codigoApi   String?  

  simulados   Simulado[]
  videos      VideoAula[]
  dicas       Dica[]

  @@map("temas")
}

model Noticia {
  id             Int      @id @default(autoincrement())
  titulo         String   @db.VarChar(200)
  resumo         String   @db.VarChar(255)
  conteudo       String   @db.Text
  urlImagem      String?  @db.VarChar(255)
  dataPublicacao DateTime @default(now())

  @@map("noticias")
}

model Carreira {
  id                 Int      @id @default(autoincrement())
  nome               String
  descricao          String?  @db.Text
  cursosRelacionados String[]
  habilidades        String[]
  img                String?
  salarioMedio       String?
  atualizadoEm       DateTime @updatedAt

  @@map("carreiras")
}

model Dica {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String   @db.Text
  foto      String?

  temaId    Int?
  tema      Tema?    @relation(fields: [temaId], references: [id], onDelete: SetNull)

  @@map("dicas")
}

model Estagio {
  id                 Int      @id @default(autoincrement())
  titulo             String   @db.VarChar(200)
  descricao          String   @db.Text
  cursosRelacionados String[]
  empresa            String?
  requisitos         String?  @db.Text
  urlInscricao       String?
  dataPublicacao     DateTime @default(now())

  @@map("estagios")
}

model Simulado {
  id              Int      @id @default(autoincrement())
  pergunta        String   @db.Text
  opcaoA          String
  opcaoB          String
  opcaoC          String
  opcaoD          String
  opcaoE          String?
  respostaCorreta String
  explicacao      String   @db.Text
  foto            String?
  
  temaId          Int?
  tema            Tema?    @relation(fields: [temaId], references: [id], onDelete: SetNull)

  resultados      SimuladoResultado[]

  @@map("simulados")
}

model SimuladoResultado {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  simuladoId   Int
  acertou      Boolean
  respondidoEm DateTime @default(now())

  // ON DELETE CASCADE? deletar um Usuário ou uma Pergunta do Simulado apaga automaticamente tudo ligado a ele no banco, evitando erros de "dados fantasmas".
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  simulado    Simulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)

  @@map("simulado_resultados")
}

model VideoAula {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String   @db.Text
  urlMidia  String
  
  temaId    Int?
  tema      Tema?    @relation(fields: [temaId], references: [id], onDelete: SetNull)
  
  @@map("video_aulas")
}

model Equipe {
  id        Int      @id @default(autoincrement())
  nome      String
  funcao    String
  foto      String?
  biografia String?  @db.Text

  @@map("equipe")
}
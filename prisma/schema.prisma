datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Participantes {
    id        Int      @id @default(autoincrement())
    nome      String
    curso     String
    foto      String
    idade     String
    email     String   @unique
    createdAt DateTime @default(now())
}

// 3. Tabela de Vídeo Aula
model VideoAula {
    id        Int    @id @default(autoincrement())
    conteudo  String
    urlMidia  String
    descricao String
}

model Dicas {
    id       Int    @id @default(autoincrement())
    conteudo String
    dicas    String
}

model Simulado {
    id              Int    @id @default(autoincrement())
    pergunta        String
    opcaoA          String
    opcaoB          String
    opcaoC          String
    opcaoD          String
    opcaoE          String
    respostaCorreta String
    explicacao      String
    materia         String
}